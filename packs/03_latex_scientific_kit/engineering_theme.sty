\newcommand{\makeengineeringcover}{%
  \begin{titlepage}
    \thispagestyle{empty}
    \begin{center}
      \vspace*{0.4cm}
      {\fontfamily{cmr}\fontsize{15}{18}\selectfont\scshape \@institucion\par}
      \vspace{0.3cm}
      {\fontfamily{cmr}\fontsize{11.5}{14}\selectfont\scshape \@facultad\par}
      \vspace{1.3cm}
      \includegraphics[width=3.8cm, height=3.8cm, keepaspectratio]{\@logotipo}\par
      \vspace{1.4cm}
      {\fontsize{15}{19}\selectfont\bfseries \@titulo\par}
      \vspace{1.4cm}
      \begin{flushleft}
        \textbf{Autores:} \@autor\\[0.35cm]
        \textbf{Asignatura:} \@asignatura\\[0.35cm]
        \textbf{Codigo:} \@codigo
      \end{flushleft}
      \vfill
      {\small\color{GrisAtenuado}\@periodo\par}
    \end{center}
  \end{titlepage}
  \newpage
  \setcounter{page}{2}
}

\newtcolorbox{scibox}[1]{
  enhanced, colback=GrisFondo, colframe=GrisBorde,
  fonttitle=\bfseries\small\color{NegroPuro}, coltitle=NegroPuro, colbacktitle=GrisClaro,
  boxrule=0.6pt, arc=2pt, title={#1}
}

\newtcolorbox{sciformula}[1]{
  enhanced, colback=white, colframe=GrisBorde,
  fonttitle=\bfseries\footnotesize\color{NegroPuro}, colbacktitle=GrisFondo,
  boxrule=0.6pt, arc=2pt, title={#1}
}

\tikzset{
  cota/.style={arrows={Latex[length=4pt]-Latex[length=4pt]}, line width=0.5pt, draw=black},
  cota texto/.style={fill=white, inner sep=1.5pt, font=\footnotesize\bfseries},
  vector carga/.style={arrows={-Latex[length=5pt]}, line width=1.1pt, draw=NegroPuro}
}

\lstdefinestyle{scistyle}{
  basicstyle=\fontsize{8.5}{11}\ttfamily,
  numbers=left, numberstyle=\tiny\color{GrisAtenuado},
  backgroundcolor=\color{GrisFondo}, frame=single, rulecolor=\color{GrisBorde},
  breaklines=true, showstringspaces=false
}
\lstset{style=scistyle}
